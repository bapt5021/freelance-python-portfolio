# Copiez ce fichier en .env et renseignez vos valeurs. Le fichier .env n'est jamais versionné.

# Token fourni par @BotFather (obligatoire)
TELEGRAM_BOT_TOKEN=

# Fichier de mesures à surveiller
MESURES_CSV=mesures.csv
# Fréquence de vérification, en minutes
INTERVALLE_MINUTES=5
# Seuil au démarrage (modifiable ensuite avec /seuil)
SEUIL_INITIAL=30
# Facultatif : n'accepter que ces chats (identifiants séparés par des virgules)
ALLOWED_CHAT_IDS=
